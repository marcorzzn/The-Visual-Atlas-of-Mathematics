                ray.setFromCamera(mouse, camera);
                if (ray.ray.intersectPlane(dragPlane, dragInt)) {
                    pos[dragging * 3] = dragInt.x - dragOff.x;
                    pos[dragging * 3 + 1] = dragInt.y - dragOff.y;
                    pos[dragging * 3 + 2] = dragInt.z - dragOff.z;
                }
                return;
            }
            updateTooltip(e);
        });
        renderer.domElement.addEventListener('mousedown', e => {
            if (e.button !== 0) return;
            updateTooltip(e);
            if (hovered !== null) {
                dragging = hovered;
                const n = new THREE.Vector3().copy(camera.position).sub(controls.target).normalize();
                dragPlane.setFromNormalAndCoplanarPoint(n, nodeMeshes[dragging].position);
                const hit = ray.ray.intersectPlane(dragPlane, dragInt);
                dragOff.copy(dragInt).sub(nodeMeshes[dragging].position);
                controls.enabled = false;
            }
        });
        renderer.domElement.addEventListener('mouseup', e => {
            if (dragging !== null) {
                if (!controls.enabled) {
                    const v = Math.abs(vel[dragging * 3]) + Math.abs(vel[dragging * 3 + 1]) + Math.abs(vel[
                        dragging * 3 + 2]);
                    if (v < 0.5) showPanel(dragging);
                }
                dragging = null;
                controls.enabled = true;
            }
        });

        function showPanel(idx) {
            const n = nodes[idx];
            document.getElementById('info-title').textContent = n.label;
            document.getElementById('info-meta').textContent = `${DN[n.disc]} · ${n.year} · ${n.type}`;
            document.getElementById('info-desc').textContent = n.desc;
            let html = '';
            const out = adj[n.id]?.out?.slice(0, 10) || [];
            const inn = adj[n.id]?.in?.slice(0, 10) || [];
            out.forEach(e => { const t = nodeMap[e.to]; if (t) html +=
                    `<div style="color:#5c8">→ ${t.label} (${t.year}) <span style="color:#555">[${RN[e.type]||e.type}]</span></div>`; });
            inn.forEach(e => { const f = nodeMap[e.from]; if (f) html +=
                    `<div style="color:#f77">← ${f.label} (${f.year}) <span style="color:#555">[${RN[e.type]||e.type}]</span></div>`; });
            const tot = (adj[n.id]?.out?.length || 0) + (adj[n.id]?.in?.length || 0);
            if (tot > 20) html += `<div style="color:#444">+${tot-20} altri collegamenti</div>`;
            document.getElementById('info-conns').innerHTML = html;
            panel.style.display = 'block';
            document.getElementById('btn-info').classList.add('active');
        }
        document.getElementById('close-info').onclick = () => panel.style.display = 'none';

        // ── UI CONTROLS ──
        let temporal = false,
            showLabels = true,
            showEdges = true;

        function toggleUI(el, state, cb) { document.getElementById(el).classList.toggle('active', state);
            cb(state); }
        document.getElementById('btn-temporal').onclick = function() { temporal = !temporal;
            toggleUI('btn-temporal', temporal, v => {}); };
        // CORRETTO: usa l'array labels invece di labelGroup (che non esisteva)
        document.getElementById('btn-labels').onclick = function() { showLabels = !showLabels;
            toggleUI('btn-labels', showLabels, v => labels.forEach(l => { l.visible = v; })); };
        document.getElementById('btn-edges').onclick = function() { showEdges = !showEdges;
            toggleUI('btn-edges', showEdges, v => edgeLines.forEach(l => l.visible = v)); };
        document.getElementById('btn-reset').onclick = () => { camera.position.set(0, 500, 1500);
            controls.target.set(0, 0, 0);
            selected = null;
            panel.style.display = 'none';
            nodeMeshes.forEach(m => { m.scale.set(1, 1, 1);
                m.material.emissiveIntensity = 0.25; }); };
        document.getElementById('btn-fullscreen').onclick = () => { if (!document.fullscreenElement) document
                .documentElement.requestFullscreen();
            else document.exitFullscreen(); };
        // CORRETTO: logica toggle dei pannelli (usa toggle senza force)
        document.getElementById('btn-filters').onclick = function() { const el = document.getElementById(
                'filters-panel');
            el.classList.toggle('hidden');
            toggleUI('btn-filters', !el.classList.contains('hidden'), () => {}); };
        document.getElementById('btn-info').onclick = function() { const show = panel.style.display === 'block';
            panel.style.display = show ? 'none' : 'block';
            toggleUI('btn-info', !show, () => {}); };
        document.getElementById('btn-legend').onclick = function() { const el = document.getElementById('legend');
            el.classList.toggle('hidden');
            toggleUI('btn-legend', !el.classList.contains('hidden'), () => {}); };
        document.getElementById('btn-minimap').onclick = function() { const el = document.getElementById('minimap');
            el.classList.toggle('hidden');
            toggleUI('btn-minimap', !el.classList.contains('hidden'), () => {}); };

        // Scorciatoie da tastiera
        window.addEventListener('keydown', e => {
            if (e.key === 'f' || e.key === 'F') document.getElementById('btn-fullscreen').click();
            if (e.key === 'h' || e.key === 'H') {
                document.getElementById('search-container').classList.toggle('hidden');
                document.getElementById('ui-controls').classList.toggle('hidden');
                document.getElementById('filters-panel').classList.toggle('hidden');
                document.getElementById('info-panel').classList.toggle('hidden');
                document.getElementById('legend').classList.toggle('hidden');
                document.getElementById('stats').classList.toggle('hidden');
                document.getElementById('help').classList.toggle('hidden');
                document.getElementById('minimap').classList.toggle('hidden');
            }
            if (e.key === '/' || e.key === '?') { document.getElementById('search-input').focus();
                e.preventDefault(); }
        });

        // ── RICERCA & AUTOCOMPLETAMENTO ──
        const searchInput = document.getElementById('search-input');
        const ac = document.getElementById('autocomplete');
        searchInput.addEventListener('input', () => {
            const q = searchInput.value.toLowerCase().trim();
            if (!q) { ac.style.display = 'none'; return; }
            const matches = nodes.filter(n => n.label.toLowerCase().includes(q) || n.desc.toLowerCase()
                .includes(q)).slice(0, 12);
            if (!matches.length) { ac.style.display = 'none'; return; }
            ac.innerHTML = matches.map(n =>
                `<div class="item" data-id="${n.id}">${n.label}<span class="disc" style="background:${DH[n.disc]}">${DN[n.disc]}</span></div>`
                ).join('');
            ac.style.display = 'block';
        });
        ac.addEventListener('click', e => {
            const item = e.target.closest('.item');
            if (!item) return;
            const id = item.dataset.id;
            ac.style.display = 'none';
            searchInput.value = nodes.find(n => n.id === id)?.label || '';
            focusNode(id);
        });

        function focusNode(id) {
            const idx = nodeIndexMap[id]; // usa nodeIndexMap invece di findIndex
            if (idx === undefined) return;
            selected = idx;
            const p = new THREE.Vector3(pos[idx * 3], pos[idx * 3 + 1], pos[idx * 3 + 2]);
            controls.target.copy(p);
            camera.position.set(p.x + 80, p.y + 60, p.z + 80);
            showPanel(idx);
            nodeMeshes.forEach((m, i) => { if (i === idx) { m.scale.set(2.5, 2.5, 2.5);
                    m.material.emissiveIntensity = 1; } else { m.scale.set(0.8, 0.8, 0.8);
                    m.material.emissiveIntensity = 0.15; } });
            setTimeout(() => { nodeMeshes.forEach((m, i) => { m.scale.set(1, 1, 1);
                    m.material.emissiveIntensity = 0.25; });
                selected = null; }, 3000);
        }
        document.getElementById('search-btn').onclick = () => { const q = searchInput.value.trim(); if (q) focusNode(
                nodes.find(n => n.label === q)?.id); };

        // ── FILTRI ──
        const discFilters = document.getElementById('disc-filters');
        const relFilters = document.getElementById('rel-filters');
        const centFilters = document.getElementById('century-filters');
        Object.keys(DN).forEach(d => {
            const l = document.createElement('label');
            l.innerHTML =
                `<input type="checkbox" checked data-disc="${d}"><span class="dd" style="background:${DH[d]}"></span>${DN[d]}`;
            discFilters.appendChild(l);
        });
        Object.keys(RN).forEach(r => {
            const l = document.createElement('label');
            l.innerHTML = `<input type="checkbox" checked data-rel="${r}">${RN[r]}`;
            relFilters.appendChild(l);
        });
        const cents = ['-4000..-500', '-500..1', '1..1000', '1000..1500', '1500..1700', '1700..1800', '1800..1900',
            '1900..1950', '1950..2000', '2000..2026'
        ];
        cents.forEach(c => {
            const l = document.createElement('label');
            l.innerHTML = `<input type="checkbox" checked data-century="${c}">${c}`;
            centFilters.appendChild(l);
        });

        // CORRETTO: logica di filtro archi con OR tra batch
        function applyFilters() {
            const ad = new Set();
            discFilters.querySelectorAll('input:checked').forEach(x => ad.add(x.dataset.disc));
            const ar = new Set();
            relFilters.querySelectorAll('input:checked').forEach(x => ar.add(x.dataset.rel));
            const ac2 = [];
            centFilters.querySelectorAll('input:checked').forEach(x => ac2.push(x.dataset.century.split('..').map(
                Number)));

            nodes.forEach((n, i) => {
                const y = parseInt(n.year) || 0;
                const ok = ad.has(n.disc) && ac2.some(([a, b]) => y >= a && y <= b);
                nodeMeshes[i].visible = ok;
                labels[i].visible = ok && showLabels;
            });

            // Reset dei batch: visibile solo se almeno un arco nel batch passa il filtro
            edgeLines.forEach(l => l.visible = false);
            edges.forEach((e, i) => {
                const fromN = nodeMap[e.from],
                    toN = nodeMap[e.to];
                const ok = ar.has(e.type) && ad.has(fromN?.disc) && ad.has(toN?.disc);
                if (ok && showEdges) {
                    for (const l of edgeLines) {
                        if (i >= l.userData.start && i < l.userData.start + edgeBatch) {
                            l.visible = true;
                            break;
                        }
                    }
                }
            });
        }
        discFilters.addEventListener('change', applyFilters);
        relFilters.addEventListener('change', applyFilters);
        centFilters.addEventListener('change', applyFilters);

        document.getElementById('stats').textContent = `${numNodes} nodi · ${edges.length} archi · 5 discipline`;

        // ── MINIMAPPA ──
        const mm = document.getElementById('minimap-canvas');
        const mctx = mm.getContext('2d');

        function drawMinimap() {
            mctx.clearRect(0, 0, 320, 200);
            mctx.fillStyle = 'rgba(8,8,16,0.8)';
            mctx.fillRect(0, 0, 320, 200);
            let minX = Infinity,
                maxX = -Infinity,
                minZ = Infinity,
                maxZ = -Infinity;
            nodes.forEach((_, i) => { minX = Math.min(minX, pos[i * 3]);
                maxX = Math.max(maxX, pos[i * 3]);
                minZ = Math.min(minZ, pos[i * 3 + 2]);
                maxZ = Math.max(maxZ, pos[i * 3 + 2]); });
            const sx = 320 / (maxX - minX || 1),
                sz = 200 / (maxZ - minZ || 1),
                s = Math.min(sx, sz) * 0.9;
            const ox = 160 - (minX + maxX) / 2 * s,
                oz = 100 - (minZ + maxZ) / 2 * s;
            nodes.forEach((n, i) => {
                mctx.fillStyle = DH[n.disc];
                mctx.beginPath();
                mctx.arc(pos[i * 3] * s + ox, pos[i * 3 + 2] * s + oz, n.disc === 'inter' ? 1.5 : 1, 0, Math
                    .PI * 2);
                mctx.fill();
            });
            // Rettangolo vista camera
            const cx = camera.position.x * s + ox,
                cz = camera.position.z * s + oz;
            mctx.strokeStyle = '#fff';
            mctx.lineWidth = 1;
            mctx.strokeRect(cx - 40, cz - 25, 80, 50);
        }

        // ── ANIMAZIONE ──
        let frame = 0;

        function animate() {
            requestAnimationFrame(animate);
            frame++;
            const steps = frame < 300 ? 4 : 1;
            for (let s = 0; s < steps; s++) layoutStep(temporal);
            for (let i = 0; i < numNodes; i++) {
                nodeMeshes[i].position.set(pos[i * 3], pos[i * 3 + 1], pos[i * 3 + 2]);
                labels[i].position.set(pos[i * 3], pos[i * 3 + 1] + 12, pos[i * 3 + 2]);
                const dist = camera.position.distanceTo(nodeMeshes[i].position);
                labels[i].visible = showLabels && dist < 2500;
            }
            updateEdges();
            if (frame % 5 === 0) drawMinimap();
            controls.update();
            renderer.render(scene, camera);
        }

        window.addEventListener('resize', () => {
            camera.aspect = innerWidth / innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(innerWidth, innerHeight);
        });

        // Nascondi loader
        setTimeout(() => {
            const ld = document.getElementById('loading');
            ld.style.opacity = '0';
            setTimeout(() => ld.style.display = 'none', 600);
        }, 800);

        animate();
    </script>
</body>
</html>

