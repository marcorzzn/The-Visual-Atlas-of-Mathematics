        function layoutStep(temporal) {
            force.fill(0);
            const dt = 0.8;
            const rep = 600000;
            const att = 0.003;
            const grav = temporal ? 0.04 : 0.0008;
            const cluster = temporal ? 0 : 0.0015;

            // Repulsione (ottimizzata: salta coppie lontane)
            for (let i = 0; i < numNodes; i++) {
                for (let j = i + 1; j < numNodes; j++) {
                    const dx = pos[j * 3] - pos[i * 3],
                        dy = pos[j * 3 + 1] - pos[i * 3 + 1],
                        dz = pos[j * 3 + 2] - pos[i * 3 + 2];
                    const d2 = dx * dx + dy * dy + dz * dz;
                    if (d2 > 1e6) continue; // Salta coppie distanti
                    const d = Math.sqrt(d2) || 1;
                    const f = rep / d2;
                    const fx = (dx / d) * f,
                        fy = (dy / d) * f,
                        fz = (dz / d) * f;
                    force[i * 3] -= fx;
                    force[i * 3 + 1] -= fy;
                    force[i * 3 + 2] -= fz;
                    force[j * 3] += fx;
                    force[j * 3 + 1] += fy;
                    force[j * 3 + 2] += fz;
                }
            }

            // Attrazione (usa nodeIndexMap per performance O(1) invece di findIndex O(N))
            edges.forEach(e => {
                const i = nodeIndexMap[e.from];
                const j = nodeIndexMap[e.to];
                if (i === undefined || j === undefined) return;
                const dx = pos[j * 3] - pos[i * 3],
                    dy = pos[j * 3 + 1] - pos[i * 3 + 1],
                    dz = pos[j * 3 + 2] - pos[i * 3 + 2];
                const d = Math.sqrt(dx * dx + dy * dy + dz * dz) || 1;
                const f = d * att;
                const fx = (dx / d) * f,
                    fy = (dy / d) * f,
                    fz = (dz / d) * f;
                force[i * 3] += fx;
                force[i * 3 + 1] += fy;
                force[i * 3 + 2] += fz;
                force[j * 3] -= fx;
                force[j * 3 + 1] -= fy;
                force[j * 3 + 2] -= fz;
            });

            // Gravità + Cluster / Temporale
            for (let i = 0; i < numNodes; i++) {
                const n = nodes[i];
                if (temporal) {
                    const y = parseInt(n.year) || 0;
                    const targetX = y * 2.5;
                    force[i * 3] += (targetX - pos[i * 3]) * grav;
                    force[i * 3 + 1] -= pos[i * 3 + 1] * 0.005;
                    force[i * 3 + 2] -= pos[i * 3 + 2] * 0.005;
                } else {
                    const c = centers[n.disc];
                    force[i * 3] += (c[0] - pos[i * 3]) * cluster + (0 - pos[i * 3]) * grav;
                    force[i * 3 + 1] += (c[1] - pos[i * 3 + 1]) * cluster + (0 - pos[i * 3 + 1]) * grav;
                    force[i * 3 + 2] += (c[2] - pos[i * 3 + 2]) * cluster + (0 - pos[i * 3 + 2]) * grav;
                }
            }

            // Integrazione
            for (let i = 0; i < numNodes; i++) {
                vel[i * 3] = (vel[i * 3] + force[i * 3] * dt) * 0.82;
                vel[i * 3 + 1] = (vel[i * 3 + 1] + force[i * 3 + 1] * dt) * 0.82;
                vel[i * 3 + 2] = (vel[i * 3 + 2] + force[i * 3 + 2] * dt) * 0.82;
                pos[i * 3] += vel[i * 3] * dt;
                pos[i * 3 + 1] += vel[i * 3 + 1] * dt;
                pos[i * 3 + 2] += vel[i * 3 + 2] * dt;
            }
        }

