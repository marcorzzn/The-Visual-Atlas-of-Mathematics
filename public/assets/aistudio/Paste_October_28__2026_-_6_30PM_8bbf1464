            top: 12px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 100;
            display: flex;
            gap: 6px;
            align-items: center;
            transition: all .4s
        }

        #search-container.hidden {
            opacity: 0;
            pointer-events: none;
            transform: translateX(-50%) translateY(-40px)
        }

        #search-input {
            width: 420px;
            padding: 9px 18px;
            border-radius: 24px;
            border: 1px solid rgba(255, 255, 255, .12);
            background: rgba(8, 8, 20, .88);
