\draw[mainArr] (cardinali) -- node[arrLbl, above]{struttura $\to$ modello} (teoriamodelli);

% =====================================================================
% CATEGORIA 33 — TEORIA DEI GRUPPI AVANZATA E RAPPRESENTAZIONI
% =====================================================================
\node[structNode, below=3.8cm of zfc] (coxeter) {\textbf{Gruppi di Coxeter}\\ \scriptsize generati da riflessioni, presentazione $(st)^{m_{st}}=e$ -- collegati ai Sistemi di Radici (Cat.\ 26) e ai Gruppi Cristallografici (Cat.\ 24), di cui sono la teoria astratta};
\node[structNode, right=2.6cm of coxeter] (artin) {\textbf{Gruppi di Artin}\\ \scriptsize tolgono la relazione $s^2=e$ dai Gruppi di Coxeter};
\node[structNode, right=2.6cm of artin] (basserre) {\textbf{Azioni su Alberi (Bass--Serre)}\\ \scriptsize un gruppo che agisce (Cat.\ 16) su un albero si decompone come prodotto amalgamato o estensione HNN};
\node[structNode, right=2.6cm of basserre] (rappind) {\textbf{Rappresentazioni Indotte}\\ \scriptsize costruiscono una rappresentazione di $G$ da una di un sottogruppo $H$; Reciprocità di Frobenius lega i caratteri (Cat.\ 20b)};
\node[structNode, right=2.6cm of rappind] (rappliecompatti) {\textbf{Rappresentazioni dei Gruppi di Lie Compatti}\\ \scriptsize sempre completamente riducibili come nel Teorema di Maschke (Cat.\ 20b) -- teoria di Peter--Weyl};

\draw[mainArr] (coxeter) -- node[arrLbl, above]{- relazione $s^2=e$} (artin);

% =====================================================================
% CATEGORIA 34 — TOPOLOGIA ALGEBRICA AVANZATA E TEORIA DEI NODI
% =====================================================================
\node[structNode, below=3.8cm of coxeter] (eilenbergmaclane) {\textbf{Spazi di Eilenberg--MacLane} $K(G,n)$\\ \scriptsize spazio con un solo gruppo di omotopia non banale, $\pi_n=G$};
\node[structNode, right=2.6cm of eilenbergmaclane] (spettraleserreseq) {\textbf{Successione Spettrale di Serre}\\ \scriptsize calcola l'Omologia (Cat.\ 20a) di uno spazio totale a partire da base e fibra};
\node[structNode, right=2.6cm of spettraleserreseq] (gruppodinodo) {\textbf{Gruppo di un Nodo}\\ \scriptsize gruppo fondamentale $\pi_1$ (Cat.\ 19) del complementare del nodo in $\mathbb{R}^3$};
\node[structNode, right=2.6cm of gruppodinodo] (alexanderjones) {\textbf{Polinomio di Alexander / Jones}\\ \scriptsize invarianti polinomiali che distinguono nodi non equivalenti};

\draw[mainArr] (eilenbergmaclane) -- node[arrLbl, above]{calcola via} (spettraleserreseq);
\draw[mainArr] (gruppodinodo) -- node[arrLbl, above]{invariante più fine} (alexanderjones);

% =====================================================================
% CATEGORIA 40 — TEOREMA DI CAYLEY E LEMMA DI BURNSIDE
% (posizionata a destra della Cat. 34, per usare lo spazio libero)
% =====================================================================
\node[structNode, right=6cm of alexanderjones] (cayleyteor) {\textbf{Teorema di Cayley}\\ \scriptsize ogni Gruppo (Cat.\ 1) si immerge in un gruppo di permutazioni, facendolo agire (Cat.\ 16) su se stesso -- \textit{il motivo per cui le Azioni di Gruppo sono universali}};
\node[structNode, right=2.6cm of cayleyteor] (burnsidelemma) {\textbf{Lemma di Burnside}\\ \scriptsize $|X/G| = \frac{1}{|G|}\sum_{g} |X^g|$: il numero di orbite è la media dei punti fissi -- \textit{il motore dietro l'Enumerazione di Pólya (Cat.\ 31)}};

\draw[mainArr] (cayleyteor) -- node[arrLbl, above]{conta le orbite dell'azione} (burnsidelemma);

% =====================================================================
% CATEGORIA 35 — TROPICALE, COMPLETAMENTI, GEOMETRIA ALGEBRICA AVANZATA
% =====================================================================
\node[structNode, below=3.8cm of eilenbergmaclane] (tropicale) {\textbf{Algebra Tropicale}\\ \scriptsize semianello $(\mathbb{R}\cup\{\infty\}, \min, +)$: la somma diventa minimo, il prodotto diventa somma};
\node[structNode, right=2.6cm of tropicale] (completamento) {\textbf{Completamento di un Anello}\\ \scriptsize analogo al completamento metrico (Cat.\ 4), ma rispetto a una filtrazione di ideali};
\node[structNode, right=2.6cm of completamento] (dimkrull) {\textbf{Dimensione di Krull}\\ \scriptsize lunghezza massima di una catena di ideali primi: generalizza la dimensione di una Varietà (Cat.\ 18)};
\node[structNode, right=2.6cm of dimkrull] (coomfasci) {\textbf{Coomologia di Fasci}\\ \scriptsize misura l'ostruzione a incollare le sezioni locali di un Fascio (Cat.\ 24) in una sezione globale};
\node[structNode, right=2.6cm of coomfasci] (divisori) {\textbf{Divisori e Fibrati in Rette}\\ \scriptsize combinazioni formali di sottovarietà di codimensione 1: linguaggio per zeri e poli};
\node[structNode, right=2.6cm of divisori] (categmonoidali) {\textbf{Categorie Monoidali}\\ \scriptsize una Categoria (Cat.\ 11) con un prodotto $\otimes$ associativo, compatibile coi morfismi};
\node[structNode, right=2.6cm of categmonoidali] (geodetiche) {\textbf{Geodetiche}\\ \scriptsize curve ad accelerazione nulla secondo la Connessione (Cat.\ 26): la generalizzazione della retta};

% =====================================================================
% CATEGORIA 36 — TENSORI AVANZATI
% =====================================================================
\node[structNode, below=3.8cm of tropicale] (riccitensore) {\textbf{Tensore di Ricci e Tensore di Weyl}\\ \scriptsize parti del Tensore di Riemann (Cat.\ 26): tracciano curvatura di volume e di forma separatamente};
\node[structNode, right=2.6cm of riccitensore] (tensoreenergimpulso) {\textbf{Tensore Energia-Impulso}\\ \scriptsize sorgente della curvatura nelle equazioni di Einstein: $G_{\mu\nu}=8\pi T_{\mu\nu}$};
\node[structNode, right=2.6cm of tensoreenergimpulso] (simmantisimm) {\textbf{Simmetrizzazione e Antisimmetrizzazione}\\ \scriptsize proiettano un Tensore (Cat.\ 10) sulla sua parte in $\mathrm{Sym}(V)$ (Cat.\ 29) o $\Lambda(V)$ (Cat.\ 5)};
\node[structNode, right=2.6cm of simmantisimm] (derivatalie) {\textbf{Derivata di Lie, Pushforward e Pullback}\\ \scriptsize modi di trasportare Tensori e Forme Differenziali (Cat.\ 18) lungo una mappa o un flusso};
\node[structNode, right=2.6cm of derivatalie] (densitatensoriale) {\textbf{Densità Tensoriale}\\ \scriptsize un Tensore (Cat.\ 10) che acquisisce un fattore $|\det J|^w$ sotto cambio di coordinate};

% =====================================================================
% CATEGORIA 37 — TEORIA DEI CODICI
% =====================================================================
\node[structNode, below=3.8cm of riccitensore] (codicilineari) {\textbf{Codici Lineari}\\ \scriptsize sottospazio $C\le \mathbb{F}_q^n$ (Cat.\ 3): i "messaggi validi" sono un sottospazio vettoriale su un Campo finito (Cat.\ 2)};
\node[structNode, right=2.6cm of codicilineari] (distanzahamming) {\textbf{Distanza di Hamming}\\ \scriptsize numero di coordinate in cui due parole differiscono: determina quanti errori un codice può correggere};
\node[structNode, right=2.6cm of distanzahamming] (reedsolomon) {\textbf{Codici di Reed--Solomon}\\ \scriptsize valutazioni di polinomi su un Campo Finito (Cat.\ 2): ottimali rispetto al limite di Singleton};

\draw[mainArr] (codicilineari) -- node[arrLbl, above]{misura la capacità correttiva} (distanzahamming);
\draw[mainArr] (codicilineari) -- node[arrLbl, above]{caso ottimale} (reedsolomon);

% =====================================================================
% CATEGORIA 38 — TRE SPIEGAZIONI STRUTTURALI (perché funziona ciò che c'è già)
% =====================================================================
\node[structNode, below=3.8cm of codicilineari] (radicalejacobson) {\textbf{Radicale di Jacobson} $J(A)$\\ \scriptsize intersezione di tutti gli ideali massimali sinistri: misura quanto un Anello (Cat.\ 2) è lontano dall'essere semisemplice};
\node[structNode, right=2.6cm of radicalejacobson] (wedderburn) {\textbf{Teorema di Wedderburn--Artin}\\ \scriptsize un anello semisemplice ($J(A)=0$) è un prodotto di anelli di matrici su corpi -- \textit{la ragione strutturale per cui il Teorema di Maschke (Cat.\ 20b) funziona}};
\node[structNode, right=4cm of wedderburn] (misurahaar) {\textbf{Misura di Haar}\\ \scriptsize unica misura invariante per traslazione su un Gruppo Topologico (Cat.\ 12) localmente compatto -- \textit{rende rigorosa l'Analisi di Fourier e la Dualità di Pontryagin (Cat.\ 19)}};
\node[structNode, right=4cm of misurahaar] (fibratoprincipale) {\textbf{Fibrato Principale}\\ \scriptsize generalizza il Fibrato Tangente (Cat.\ 18): fibra $=$ un Gruppo di Lie (Cat.\ 12) che agisce liberamente -- \textit{è dove vive davvero una Connessione (Cat.\ 26) in generale}};

\draw[mainArr] (radicalejacobson) -- node[arrLbl, above]{$J(A)=0$} (wedderburn);

