% =====================================================================
% CATEGORIA 1 — STRUTTURE ALGEBRICHE DI BASE
% =====================================================================
\node[structNode] (magma) {\textbf{Magma}\\ \scriptsize insieme $M$ con operazione binaria $\ast: M\times M \to M$};
\node[structNode, right=2.6cm of magma] (semigruppo) {\textbf{Semigruppo}\\ \scriptsize $\ast$ associativa: $(a\ast b)\ast c = a\ast(b\ast c)$};
\node[structNode, right=2.6cm of semigruppo] (monoide) {\textbf{Monoide}\\ \scriptsize esiste elemento neutro $e$: $a\ast e = e\ast a = a$};
\node[structNode, right=2.6cm of monoide] (gruppo) {\textbf{Gruppo}\\ \scriptsize ogni elemento ha inverso: $a\ast a^{-1}=e$};
\node[structNode, right=2.6cm of gruppo] (gruppoab) {\textbf{Gruppo Abeliano}\\ \scriptsize $\ast$ commutativa: $a\ast b = b\ast a$};

\draw[mainArr] (magma) -- node[arrLbl, above]{+ associatività} (semigruppo);
\draw[mainArr] (semigruppo) -- node[arrLbl, above]{+ elemento neutro} (monoide);
\draw[mainArr] (monoide) -- node[arrLbl, above]{+ inverso} (gruppo);
\draw[mainArr] (gruppo) -- node[arrLbl, above]{+ commutatività} (gruppoab);

% =====================================================================
% CATEGORIA 2 — ANELLI E CAMPI
% =====================================================================
\node[structNode, below=3.6cm of semigruppo] (anello) {\textbf{Anello} $(A,+,\times)$\\ \scriptsize gruppo abeliano $(A,+)$ e monoide $(A,\times)$, distributività};
\node[structNode, right=2.6cm of anello] (anellocomm) {\textbf{Anello Commutativo}\\ \scriptsize $\times$ commutativo};
\node[structNode, right=2.8cm of anellocomm] (dominiointeg) {\textbf{Dominio d'Integrità}\\ \scriptsize nessun divisore dello zero: $ab=0 \Rightarrow a=0$ o $b=0$};
\node[structNode, right=2.6cm of dominiointeg] (ufd) {\textbf{UFD}\\ \scriptsize fattorizzazione in irriducibili unica (a meno di unità/ordine)};
\node[structNode, right=2.6cm of ufd] (pid) {\textbf{PID}\\ \scriptsize ogni ideale è principale: $I=(a)$};
\node[structNode, right=2.8cm of pid] (euclideo) {\textbf{Dominio Euclideo}\\ \scriptsize esiste norma $\delta$ e algoritmo di divisione con resto};
\node[structNode, right=2.6cm of euclideo] (campo) {\textbf{Campo}\\ \scriptsize ogni elemento non nullo è invertibile per $\times$ -- \textit{campi finiti: base della Crittografia (AES, curve ellittiche)}};

\draw[mainArr] (anello) -- node[arrLbl, above]{+ commutatività} (anellocomm);
\draw[mainArr] (anellocomm) -- node[arrLbl, above]{+ no zero-divisori} (dominiointeg);
\draw[mainArr] (dominiointeg) -- node[arrLbl, above]{+ fattoriz.\ unica} (ufd);
\draw[mainArr] (ufd) -- node[arrLbl, above]{+ ideali principali} (pid);
\draw[mainArr] (pid) -- node[arrLbl, above]{+ algoritmo divisione} (euclideo);
\draw[mainArr] (euclideo) -- node[arrLbl, above]{+ ogni elem.\ invertibile} (campo);

% =====================================================================
% CATEGORIA 3 — MODULI E SPAZI VETTORIALI
% =====================================================================
\node[structNode, below=3.6cm of anellocomm] (modulo) {\textbf{Modulo} su anello $R$\\ \scriptsize gruppo abeliano $(M,+)$ con azione $R\times M \to M$};
\node[structNode, right=3.0cm of modulo] (spaziovett) {\textbf{Spazio Vettoriale}\\ \scriptsize modulo su un campo $\mathbb{K}$ -- \textit{es.\ fisici: posizione, velocità, forza}};

\draw[mainArr] (modulo) -- node[arrLbl, above]{$R \rightsquigarrow \mathbb{K}$ (campo)} (spaziovett);

% =====================================================================
% CATEGORIA 4 — STRUTTURE TOPOLOGICHE E METRICHE
% =====================================================================
\node[structNode, right=7.0cm of euclideo, yshift=0cm] (topologico) {\textbf{Spazio Topologico}\\ \scriptsize insieme $X$ con famiglia di aperti $\tau$};
\node[structNode, below=2.6cm of topologico] (metrico) {\textbf{Spazio Metrico}\\ \scriptsize funzione distanza $d(x,y)$};
\node[structNode, below=2.6cm of metrico] (normato) {\textbf{Spazio Normato}\\ \scriptsize spazio vettoriale + norma $\lVert v \rVert$};
\node[structNode, below=2.6cm of normato, xshift=-2.6cm] (banach) {\textbf{Spazio di Banach}\\ \scriptsize normato e completo (Cauchy $\Rightarrow$ convergente)};
\node[structNode, below=2.6cm of normato, xshift=2.6cm] (prodint) {\textbf{Spazio con Prodotto Interno}\\ \scriptsize forma bilineare $\langle \cdot,\cdot\rangle$, $\lVert v \rVert = \sqrt{\langle v,v\rangle}$};
\node[structNode, below=2.6cm of prodint] (hilbert) {\textbf{Spazio di Hilbert}\\ \scriptsize prodotto interno e completo -- \textit{cuore dell'Analisi Funzionale: operatori, spettro}};

\draw[mainArr] (topologico) -- node[arrLbl, right]{+ funzione distanza} (metrico);
\draw[mainArr] (metrico) -- node[arrLbl, right]{+ struttura lineare, norma} (normato);
\draw[mainArr] (normato) -- node[arrLbl, left]{+ completezza} (banach);
