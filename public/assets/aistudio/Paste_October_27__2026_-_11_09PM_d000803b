% =====================================================================
% CATEGORIA 6 — ALGEBRE DI DIVISIONE NORMATE (Cayley--Dickson)
% =====================================================================
\node[structNode, right=6.5cm of clifford] (reali) {\textbf{Reali} $\mathbb{R}$\\ \scriptsize dim 1: campo, algebra di divisione banale};
\node[structNode, right=2.6cm of reali] (complessi) {\textbf{Complessi} $\mathbb{C}$\\ \scriptsize dim 2: associativa, commutativa};
\node[structNode, right=2.6cm of complessi] (quaternioni) {\textbf{Quaternioni} $\mathbb{H}$\\ \scriptsize dim 4: associativa, NON commutativa -- \textit{rappresentano le rotazioni in 3D: doppio rivestimento di $SO(3)$ (Cat.\ 8)}};
\node[structNode, right=2.6cm of quaternioni] (ottonioni) {\textbf{Ottonioni} $\mathbb{O}$\\ \scriptsize dim 8: NON associativa (alternativa), non commutativa};
\node[structNode, dashed, right=2.8cm of ottonioni] (sedenioni) {\textbf{Sedenioni} $\mathbb{S}$\\ \scriptsize dim 16: compaiono divisori dello zero -- non più divisione};

\draw[mainArr] (reali) -- node[arrLbl, above]{Cayley--Dickson} (complessi);
\draw[mainArr] (complessi) -- node[arrLbl, above]{+ non commutatività} (quaternioni);
\draw[mainArr] (quaternioni) -- node[arrLbl, above]{+ non associatività} (ottonioni);
\draw[mainArr, dashed] (ottonioni) -- node[arrLbl, above]{rottura: $\exists$ divisori dello zero} (sedenioni);

\draw[crossArr] (algcampo.east) to[out=0, in=150] node[arrLbl, above, pos=0.55]{Hurwitz: uniche algebre di divisione normate reali} (quaternioni.north);
\draw[crossArr] (clifford) to[bend right=20] node[arrLbl, below]{$C\ell_{0,2}(\mathbb{R}) \cong \mathbb{H}$} (quaternioni.south);

% =====================================================================
% CATEGORIA 7 — APPLICAZIONI TRA STRUTTURE: MORFISMI E FUNZIONALI
% =====================================================================
\node[structNode, below=3.6cm of grassmann] (funzione) {\textbf{Funzione} $f:A\to B$\\ \scriptsize corrispondenza che associa a ogni $a\in A$ un unico $b\in B$};
\node[structNode, below=2.2cm of funzione] (omomorfismo) {\textbf{Omomorfismo}\\ \scriptsize $f(a\ast b)=f(a)\ast f(b)$: preserva le operazioni della struttura};
\node[structNode, right=2.6cm of omomorfismo] (isomorfismo) {\textbf{Isomorfismo}\\ \scriptsize omomorfismo biettivo, la cui inversa è anch'essa un omomorfismo};
\node[structNode, left=2.6cm of omomorfismo] (endomorfismo) {\textbf{Endomorfismo}\\ \scriptsize omomorfismo $f:A\to A$: stesso dominio e codominio};
\node[structNode, below=2.2cm of omomorfismo] (automorfismo) {\textbf{Automorfismo}\\ \scriptsize isomorfismo $f:A\to A$: biettivo e dominio $=$ codominio -- \textit{l'insieme $\mathrm{Aut}(A)$ è esso stesso un Gruppo (Cat.\ 1), sotto composizione}};
\node[structNode, below=3.4cm of isomorfismo] (operatorelineare) {\textbf{Operatore Lineare} $T:V\to W$\\ \scriptsize $T(\alpha v+\beta w)=\alpha T(v)+\beta T(w)$: omomorfismo tra spazi vettoriali -- \textit{operatori differenziali: Analisi Numerica, Equazioni Differenziali}};
\node[structNode, below=2.2cm of operatorelineare] (formalineare) {\textbf{Forma Lineare (Funzionale)} $\varphi:V\to\mathbb{K}$\\ \scriptsize operatore lineare a valori nel campo scalare};
\node[structNode, below=2.2cm of formalineare] (spazioduale) {\textbf{Spazio Duale} $V^{*}$\\ \scriptsize insieme di tutti i funzionali lineari: $V^{*}=\mathrm{Hom}(V,\mathbb{K})$};
\node[structNode, right=2.6cm of spazioduale] (covettore) {\textbf{Covettore}\\ \scriptsize elemento di $V^{*}$: "mangia" un vettore e restituisce uno scalare};
\node[structNode, right=2.6cm of operatorelineare] (formabilineare) {\textbf{Forma Bilineare} $B:V\times V\to\mathbb{K}$\\ \scriptsize lineare separatamente in ciascun argomento -- \textit{es.: il Prodotto Interno (Cat.\ 4) è il caso simmetrico definito positivo}};
\node[structNode, below=2.2cm of covettore] (varianza) {\textbf{Varianza / Controvarianza}\\ \scriptsize vettori: componenti controvarianti; covettori: componenti covarianti -- trasformano in modo opposto al cambio di base};

\draw[mainArr] (funzione) -- node[arrLbl, right]{+ preserva le operazioni} (omomorfismo);
\draw[mainArr] (omomorfismo) -- node[arrLbl, above]{+ biettivo, inversa omom.} (isomorfismo);
\draw[mainArr] (omomorfismo) -- node[arrLbl, above]{dominio $=$ codominio} (endomorfismo);
\draw[mainArr] (isomorfismo) -- node[arrLbl, right]{+ dominio $=$ codominio} (automorfismo);
\draw[mainArr] (endomorfismo) to[bend right=15] node[arrLbl, left]{+ biettivo} (automorfismo);
\draw[mainArr] (isomorfismo) -- node[arrLbl, right]{specializz.: $V,W$ spazi vett.} (operatorelineare);
\draw[mainArr] (operatorelineare) -- node[arrLbl, right]{codominio $=\mathbb{K}$} (formalineare);
\draw[mainArr] (formalineare) -- node[arrLbl, right]{insieme di tutti i $\varphi$} (spazioduale);
\draw[mainArr] (spazioduale) -- node[arrLbl, above]{i suoi elementi si chiamano} (covettore);
\draw[mainArr] (operatorelineare) -- node[arrLbl, above]{generalizz.\ a 2 argomenti} (formabilineare);
\draw[mainArr] (covettore) -- node[arrLbl, right]{+ trasformazione sotto cambio base} (varianza);

% =====================================================================
% CATEGORIA 8 — GEOMETRIA AFFINE E TRASFORMAZIONI
% =====================================================================
\node[structNode, below=3.6cm of sedenioni] (spazioaffine) {\textbf{Spazio Affine}\\ \scriptsize punti $+$ spazio vettoriale delle traslazioni: uno spazio vettoriale che ha dimenticato l'origine};
\node[structNode, right=2.6cm of spazioaffine] (trasfaffine) {\textbf{Trasformazione Affine}\\ \scriptsize $x\mapsto Ax+b$: preserva combinazioni affini e rette};
\node[structNode, right=2.6cm of trasfaffine] (isometria) {\textbf{Isometria}\\ \scriptsize preserva le distanze: $d(f(x),f(y))=d(x,y)$ -- \textit{formalizza la distanza già vista in Spazio Metrico (Cat.\ 4)}};
\node[structNode, right=2.6cm of isometria] (rotazione) {\textbf{Rotazione}\\ \scriptsize isometria che fissa un punto e preserva l'orientazione: gruppo $SO(n)$ -- \textit{per $n=3$, rappresentata dai Quaternioni (Cat.\ 6)}};
\node[structNode, right=2.6cm of rotazione] (movimenti) {\textbf{Gruppo dei Movimenti}\\ \scriptsize $\mathrm{Isom}(\mathbb{R}^n)=O(n)\ltimes\mathbb{R}^n$};

\draw[mainArr] (spazioaffine) -- node[arrLbl, above]{+ struttura metrica} (trasfaffine);
\draw[mainArr] (trasfaffine) -- node[arrLbl, above]{+ preserva le distanze} (isometria);
\draw[mainArr] (isometria) -- node[arrLbl, above]{+ fissa un punto, orientaz.} (rotazione);
\draw[mainArr] (isometria) -- node[arrLbl, below]{struttura di gruppo} (movimenti);

