\node[structNode, below=6.5cm of trascendenti] (tensoretipo) {\textbf{Tensore di tipo} $(p,q)$\\ \scriptsize elemento di $V^{\otimes p}\otimes(V^{*})^{\otimes q}$: $p$ indici controvarianti, $q$ covarianti};
\node[structNode, below=2.2cm of tensoretipo] (multivettore) {\textbf{Multivettore ($k$-vettore)}\\ \scriptsize elemento omogeneo di grado $k$ dell'algebra di Grassmann $\Lambda(V)$};
\node[structNode, below=2.2cm of multivettore] (bivettore) {\textbf{Bivettore}\\ \scriptsize multivettore di grado 2: rappresenta un'area orientata, $v\wedge w$ -- \textit{es.: momento angolare, momento di una forza}};

\draw[mainArr] (tensoretipo) -- node[arrLbl, right]{caso antisimmetrico puro} (multivettore);
\draw[mainArr] (multivettore) -- node[arrLbl, right]{caso $k=2$} (bivettore);

% =====================================================================
% CATEGORIA 11 — TEORIA DELLE CATEGORIE (IL META-LIVELLO)
% =====================================================================
\node[structNode, below=5.5cm of varianza] (categoria) {\textbf{Categoria}\\ \scriptsize oggetti $+$ morfismi, composizione associativa, identità. (Grp, Vect$_\mathbb{K}$, Top, ... sono categorie: gli omomorfismi ne sono i morfismi)};
\node[structNode, right=2.6cm of categoria] (funtore) {\textbf{Funtore}\\ \scriptsize "omomorfismo tra categorie": preserva composizione e identità};
\node[structNode, right=2.6cm of funtore] (isonaturale) {\textbf{Isomorfismo Naturale}\\ \scriptsize trasformazione naturale invertibile fra due funtori};
\node[structNode, below=2.4cm of funtore] (curryhoward) {\textbf{Corrispondenza Curry--Howard--Lambek}\\ \scriptsize proposizioni $\cong$ tipi $\cong$ oggetti; dimostrazioni $\cong$ programmi $\cong$ morfismi};

\draw[mainArr] (categoria) -- node[arrLbl, above]{+ applicazione tra categorie} (funtore);
\draw[mainArr] (funtore) -- node[arrLbl, above]{+ trasf.\ naturale invertibile} (isonaturale);
\draw[mainArr] (categoria) to[bend right=10] node[arrLbl, left]{logica $\leftrightarrow$ tipi $\leftrightarrow$ categorie} (curryhoward);

