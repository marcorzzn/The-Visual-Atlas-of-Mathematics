% =====================================================================
\node[structNode, right=4cm of gruppolie] (poset) {\textbf{Insieme Parzialmente Ordinato}\\ \scriptsize relazione $\le$: riflessiva, antisimmetrica, transitiva};
\node[structNode, right=2.6cm of poset] (reticolo) {\textbf{Reticolo}\\ \scriptsize ogni coppia ha estremo superiore (join $\vee$) e inferiore (meet $\wedge$)};
\node[structNode, right=2.6cm of reticolo] (algebrabool) {\textbf{Algebra di Boole}\\ \scriptsize reticolo distributivo e complementato: es.\ $(\mathcal{P}(X),\cup,\cap,\complement)$ -- \textit{equivalente a un anello booleano, dove $x^2=x$ per ogni $x$ (Cat.\ 2)}};

