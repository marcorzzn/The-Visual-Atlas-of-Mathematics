% CATEGORIA 21 — GEOMETRIE DI KLEIN E DECOMPOSIZIONI MATRICIALI
% =====================================================================
\node[structNode, below=3.6cm of omologia] (proiettiva) {\textbf{Geometria Proiettiva}\\ \scriptsize gruppo $PGL(n+1,\mathbb{K})$: l'invariante è il birapporto; i punti all'infinito diventano punti come gli altri -- \textit{tutte le coniche non degeneri (cerchio, ellisse, parabola, iperbole) sono proiettivamente equivalenti: a distinguerle è solo la Geometria Euclidea, più restrittiva}};
\node[structNode, right=2.6cm of proiettiva] (euclidea) {\textbf{Geometria Euclidea}\\ \scriptsize gruppo $\mathrm{Isom}(\mathbb{R}^n)$ (Cat.\ 8): l'invariante è la distanza -- il caso più restrittivo della gerarchia di Klein};
\node[structNode, right=2.6cm of euclidea] (iperbolica) {\textbf{Geometria Iperbolica}\\ \scriptsize gruppo delle isometrie del modello di Poincaré: nega il V postulato -- per un punto esterno a una retta passano infinite parallele};
\node[structNode, right=4cm of iperbolica] (autovalori) {\textbf{Autovalori e Autovettori}\\ \scriptsize $Tv=\lambda v$: le direzioni che un operatore lineare lascia invariate, a meno di scala};
\node[structNode, right=2.6cm of autovalori] (diagonalizzazione) {\textbf{Diagonalizzazione}\\ \scriptsize $T$ è diagonalizzabile se ammette una base di autovettori: $T=PDP^{-1}$};
\node[structNode, right=2.6cm of diagonalizzazione] (formajordan) {\textbf{Forma Canonica di Jordan}\\ \scriptsize la migliore approssimazione alla diagonalizzazione quando mancano abbastanza autovettori};
\node[structNode, below=2.2cm of diagonalizzazione] (svd) {\textbf{Decomposizione ai Valori Singolari (SVD)}\\ \scriptsize $T=U\Sigma V^{*}$: funziona per qualunque operatore, anche non quadrato -- \textit{cuore dell'Analisi Numerica}};

\draw[mainArr] (proiettiva) -- node[arrLbl, above]{+ fissa l'iperpiano all'infinito (via Cat.\ 8)} (euclidea);
