% CATEGORIA 12 — GRUPPI TOPOLOGICI E GRUPPI DI LIE
% =====================================================================
\node[structNode, below=4.5cm of curryhoward] (gruppotop) {\textbf{Gruppo Topologico}\\ \scriptsize gruppo $+$ topologia: prodotto e inverso sono operazioni continue};
\node[structNode, right=2.6cm of gruppotop] (gruppolie) {\textbf{Gruppo di Lie}\\ \scriptsize gruppo topologico che è anche varietà liscia; la sua algebra di Lie è lo spazio tangente all'identità -- \textit{simmetrie in Meccanica Razionale (Teorema di Noether) e Fisica Matematica}};

\draw[mainArr] (gruppotop) -- node[arrLbl, above]{+ struttura di varietà liscia} (gruppolie);

