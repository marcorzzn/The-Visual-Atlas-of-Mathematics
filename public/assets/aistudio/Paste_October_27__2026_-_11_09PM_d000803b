% CATEGORIA 23 — MECCANICA RAZIONALE E FISICA MATEMATICA COME ALGEBRA
% =====================================================================
\node[structNode, below=4.5cm of gruppiabelianifiniti] (formasimplettica) {\textbf{Forma Simplettica} $\omega$\\ \scriptsize forma differenziale di grado 2 (Cat.\ 18), chiusa ($d\omega=0$) e non degenere -- \textit{la struttura algebrica dello Spazio delle Fasi in Meccanica Hamiltoniana}};
\node[structNode, right=2.6cm of formasimplettica] (noetherteor) {\textbf{Teorema di Noether}\\ \scriptsize ad ogni simmetria continua (un'Azione di Gruppo di Lie, Cat.\ 12/16) corrisponde una quantità conservata: energia, quantità di moto, momento angolare};
\node[structNode, right=2.6cm of noetherteor] (poincaregruppo) {\textbf{Gruppo di Poincaré / di Lorentz}\\ \scriptsize isometrie dello spaziotempo di Minkowski -- \textit{qui la Forma Bilineare (Cat.\ 7) è indefinita, non definita positiva}};
\node[structNode, below=2.4cm of formasimplettica] (legendre) {\textbf{Trasformata di Legendre}\\ \scriptsize converte la Lagrangiana $L(q,\dot q)$, che vive sul Fibrato Tangente $TM$ (Cat.\ 18), nell'Hamiltoniana $H(q,p)$, che vive sul fibrato cotangente -- dove abita la Forma Simplettica};
\node[structNode, right=2.6cm of legendre] (osservabile) {\textbf{Operatore Autoaggiunto} $T=T^{*}$\\ \scriptsize su uno Spazio di Hilbert (Cat.\ 4): autovalori sempre reali (Cat.\ 21b) -- \textit{in Meccanica Quantistica rappresenta un'osservabile fisica}};

\draw[mainArr] (legendre) -- node[arrLbl, above]{passa al fibrato cotangente} (formasimplettica);

