% CATEGORIA 19 — ANALOGIE E CORRISPONDENZE TRASVERSALI
% =====================================================================
\node[structNode, below=4.5cm of nullstellensatz] (motivoquoziente) {\textbf{Il Motivo del Quoziente}\\ \scriptsize la stessa costruzione ricorre ovunque: $T(V)/I=\Lambda(V),\,C\ell_q(V),\,U(\mathfrak{g})$; $G/N$; $A/I$; $V/W$ -- \textit{sempre: dichiarare per decreto che qualcosa vale zero}};
\node[structNode, right=2.6cm of motivoquoziente] (dualitastone) {\textbf{Dualità di Stone}\\ \scriptsize Algebra di Boole $\leftrightarrow$ Spazio Topologico compatto totalmente sconnesso -- \textit{la stessa Corrispondenza di Galois, applicata a reticoli e spazi}};
\node[structNode, right=2.6cm of dualitastone] (dualitapontryagin) {\textbf{Dualità di Pontryagin}\\ \scriptsize Gruppo Abeliano localmente compatto $\leftrightarrow$ Gruppo dei Caratteri $\hat{G}=\mathrm{Hom}(G,U(1))$ -- \textit{l'analogo, per i gruppi, dello Spazio Duale $V^{*}$}};
\node[structNode, below=2.4cm of motivoquoziente] (rivestimenti) {\textbf{Rivestimenti e Gruppo Fondamentale} $\pi_1(X)$\\ \scriptsize sottogruppi di $\pi_1(X)$ $\leftrightarrow$ rivestimenti di $X$ -- \textit{identica struttura della Corrispondenza di Galois: sottogruppi $\leftrightarrow$ campi intermedi}};
\node[structNode, right=2.6cm of rivestimenti] (erlangen) {\textbf{Programma di Erlangen (Klein)}\\ \scriptsize una geometria $=$ un gruppo di trasformazioni $+$ le sue proprietà invarianti -- \textit{isometrie, rotazioni e trasformazioni affini, già viste, ne sono l'esempio canonico}};
\node[structNode, right=2.6cm of erlangen] (rappresentazione) {\textbf{Rappresentazione di un Gruppo} $\rho: G\to GL(V)$\\ \scriptsize omomorfismo di un gruppo in operatori lineari -- \textit{traduce la teoria dei gruppi (Cat.\ 16) in algebra lineare (Cat.\ 7); è esattamente un modulo su $\mathbb{K}[G]$ (Cat.\ 3)}};

% =====================================================================
% CATEGORIA 20 — TRE ESTENSIONI PROFONDE (non un elenco: tre parallelismi scelti)
% =====================================================================
\node[structNode, below=3.6cm of rivestimenti] (omologia) {\textbf{Gruppi di Omologia} $H_n(X)$\\ \scriptsize invarianti algebrici (gruppi abeliani) che misurano i "buchi" $n$-dimensionali di uno spazio topologico};
\node[structNode, right=2.6cm of omologia] (coomologia) {\textbf{Coomologia} $H^n(X)$\\ \scriptsize duale dell'omologia; il prodotto cup la rende un anello graduato -- \textit{lo Spazio Duale, applicato alla topologia}};
\node[structNode, right=4cm of coomologia] (maschke) {\textbf{Teorema di Maschke}\\ \scriptsize se $|G|$ è finito e invertibile nel campo, ogni rappresentazione si decompone in irriducibili};
\node[structNode, right=2.6cm of maschke] (schur) {\textbf{Lemma di Schur}\\ \scriptsize un omomorfismo tra rappresentazioni irriducibili è nullo oppure un isomorfismo};
\node[structNode, right=2.6cm of schur] (caratteri) {\textbf{Carattere} $\chi(g)=\mathrm{tr}(\rho(g))$\\ \scriptsize classifica le rappresentazioni -- \textit{per $G$ abeliano ritrova esattamente la Dualità di Pontryagin}};
\node[structNode, right=4cm of caratteri] (ostrowski) {\textbf{Teorema di Ostrowski}\\ \scriptsize le uniche valutazioni non banali su $\mathbb{Q}$ sono $|\cdot|_\infty$ (l'usuale) e le $|\cdot|_p$ $p$-adiche, una per ogni primo};
\node[structNode, right=2.6cm of ostrowski] (padici) {\textbf{Numeri $p$-adici} $\mathbb{Q}_p$\\ \scriptsize completamento di $\mathbb{Q}$ rispetto a $|\cdot|_p$ -- \textit{la stessa identica costruzione di $\mathbb{R}$, con una distanza diversa}};

