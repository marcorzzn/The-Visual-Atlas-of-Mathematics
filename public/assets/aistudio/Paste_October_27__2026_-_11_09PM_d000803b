% =====================================================================
\node[structNode, right=4cm of algebrabool] (algebrajordan) {\textbf{Algebra di Jordan}\\ \scriptsize prodotto commutativo non associativo $a\circ b=\tfrac12(ab+ba)$: simmetrizzazione di un'algebra associativa};
\node[structNode, right=2.6cm of algebrajordan] (quasigruppo) {\textbf{Quasigruppo}\\ \scriptsize magma in cui la divisione è sempre possibile (tavola latina): gruppo senza associatività};
\node[structNode, right=2.6cm of quasigruppo] (loop) {\textbf{Loop}\\ \scriptsize quasigruppo con elemento neutro};

\draw[mainArr] (quasigruppo) -- node[arrLbl, above]{+ elemento neutro} (loop);

% =====================================================================
% CATEGORIA 15 — SOTTOSTRUTTURE, QUOZIENTI E TEOREMI DI ISOMORFISMO
% =====================================================================
\node[structNode, below=4.2cm of gruppotop] (sottogruppo) {\textbf{Sottogruppo} $H\le G$\\ \scriptsize sottoinsieme chiuso rispetto a operazione e inverso};
\node[structNode, right=2.6cm of sottogruppo] (sottogruppon) {\textbf{Sottogruppo Normale} $N\trianglelefteq G$\\ \scriptsize $gNg^{-1}=N$ per ogni $g$: le classi laterali formano un gruppo};
\node[structNode, right=2.6cm of sottogruppon] (gruppoquoz) {\textbf{Gruppo Quoziente} $G/N$\\ \scriptsize classi laterali di un sottogruppo normale, con operazione indotta};
\node[structNode, below=2.4cm of sottogruppo] (ideale) {\textbf{Ideale} $I\trianglelefteq A$\\ \scriptsize sottogruppo additivo che assorbe la moltiplicazione: $aI\subseteq I$};
\node[structNode, right=2.6cm of ideale] (anelloquoz) {\textbf{Anello Quoziente} $A/I$\\ \scriptsize classi di resto modulo un ideale, eredita $+$ e $\times$};
\node[structNode, below=2.4cm of ideale] (sottospazio2) {\textbf{Sottospazio Vettoriale} $W\le V$\\ \scriptsize sottoinsieme chiuso rispetto a combinazioni lineari};
\node[structNode, right=2.6cm of sottospazio2] (spazioquoz) {\textbf{Spazio Quoziente} $V/W$\\ \scriptsize classi laterali di un sottospazio, ancora spazio vettoriale};
\node[structNode, right=5cm of gruppoquoz] (nucleo) {\textbf{Nucleo} $\ker f$\\ \scriptsize $\{a: f(a)=e\}$: sempre sottogruppo normale (o ideale, o sottospazio)};
\node[structNode, below=2.4cm of nucleo] (immagine) {\textbf{Immagine} $\mathrm{im}\,f$\\ \scriptsize $\{f(a): a\in A\}$: sottostruttura del codominio};
\node[structNode, below=2.4cm of immagine] (teoremaiso1) {\textbf{1° Teorema di Isomorfismo}\\ \scriptsize $G/\ker f \cong \mathrm{im}\,f$: vale, con la notazione giusta, per gruppi, anelli e spazi vettoriali};

