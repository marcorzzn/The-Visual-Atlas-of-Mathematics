% CATEGORIA 16 — AZIONI DI GRUPPO
% =====================================================================
\node[structNode, right=5cm of nucleo] (azionegruppo) {\textbf{Azione di Gruppo} $G\curvearrowright X$\\ \scriptsize omomorfismo $G\to\mathrm{Sym}(X)$: $G$ agisce sull'insieme $X$};
\node[structNode, right=2.6cm of azionegruppo] (orbita) {\textbf{Orbita} $G\cdot x$\\ \scriptsize $\{g\cdot x: g\in G\}$: punti raggiungibili da $x$};
\node[structNode, below=2.4cm of azionegruppo] (stabilizzatore) {\textbf{Stabilizzatore} $G_x$\\ \scriptsize $\{g\in G: g\cdot x = x\}$: sottogruppo che fissa $x$};
\node[structNode, below=2.4cm of orbita] (teoremaorbstab) {\textbf{Teorema Orbita-Stabilizzatore}\\ \scriptsize $|G| = |G\cdot x|\cdot|G_x|$};
\node[structNode, below=2.4cm of teoremaorbstab] (sylow) {\textbf{Teoremi di Sylow}\\ \scriptsize esistenza, coniugio e conteggio dei sottogruppi di ordine massimo $p^k$};

