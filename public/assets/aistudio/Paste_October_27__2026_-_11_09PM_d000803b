% =====================================================================
\node[structNode, below=4.5cm of osservabile] (algebrahopf) {\textbf{Algebra di Hopf}\\ \scriptsize algebra + coalgebra compatibili: oltre al prodotto, un coprodotto $\Delta: A\to A\otimes A$ che duplica la struttura -- \textit{$U(\mathfrak{g})$ (Cat.\ 5) ne è l'esempio canonico}};
\node[structNode, right=2.6cm of algebrahopf] (fasci) {\textbf{Fascio (Sheaf)}\\ \scriptsize assegna dati algebrici (es.\ anelli) a ogni aperto di uno spazio, compatibili per restrizione -- \textit{il linguaggio moderno della Geometria Algebrica: generalizza Varietà e Nullstellensatz, Cat.\ 18}};
\node[structNode, right=2.6cm of fasci] (cristallografici) {\textbf{Gruppi Cristallografici}\\ \scriptsize sottogruppi discreti e cocompatti di $\mathrm{Isom}(\mathbb{R}^n)$ (Cat.\ 8): 17 nel piano (gruppi wallpaper), 230 nello spazio};

