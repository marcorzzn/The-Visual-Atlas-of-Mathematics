% CATEGORIA 26 — TEORIA DI LIE, GEOMETRIA ALGEBRICA E DIFFERENZIALE AVANZATE
% =====================================================================
\node[structNode, below=4.2cm of dedekind] (sistemaradici) {\textbf{Sistema di Radici}\\ \scriptsize configurazione di vettori che codifica le simmetrie di un'Algebra di Lie semisemplice (Cat.\ 5)};
\node[structNode, right=2.6cm of sistemaradici] (dynkin) {\textbf{Diagramma di Dynkin}\\ \scriptsize codifica combinatoria di un Sistema di Radici -- classifica completamente le Algebre di Lie semisemplici};
\node[structNode, right=2.6cm of dynkin] (schema) {\textbf{Schema}\\ \scriptsize generalizza la Varietà Algebrica (Cat.\ 18) incollando $\mathrm{Spec}(A)$ di anelli qualsiasi, non solo campi algebricamente chiusi};
\node[structNode, right=2.6cm of schema] (connessione) {\textbf{Connessione}\\ \scriptsize regola per derivare Campi Vettoriali (Cat.\ 18) lungo una varietà -- necessaria per confrontare vettori tangenti in punti diversi};
\node[structNode, right=2.6cm of connessione] (curvatura) {\textbf{Curvatura / Tensore di Riemann}\\ \scriptsize misura quanto una Connessione fallisce nel far commutare le derivate -- si annulla esattamente quando lo spazio è piatto};

\draw[mainArr] (sistemaradici) -- node[arrLbl, above]{codifica combinatoria} (dynkin);
\draw[mainArr] (connessione) -- node[arrLbl, above]{+ mancata commutatività} (curvatura);

% =====================================================================
% CATEGORIA 27 — ANALISI FUNZIONALE AVANZATA E GEOMETRIA NON COMMUTATIVA
% =====================================================================
\node[structNode, below=4.2cm of sistemaradici] (algebraC) {\textbf{Algebra C*}\\ \scriptsize Algebra di Banach (Cat.\ 4) con involuzione $*$ tale che $\lVert a^{*}a\rVert = \lVert a\rVert^2$};
\node[structNode, right=2.6cm of algebraC] (gelfandnaimark) {\textbf{Teorema di Gelfand--Naimark}\\ \scriptsize ogni Algebra C* commutativa è $C(X)$ per uno Spazio Topologico $X$ (Cat.\ 4) -- \textit{un'altra Dualità di Stone (Cat.\ 19)}};
\node[structNode, right=2.6cm of gelfandnaimark] (noncommutativa) {\textbf{Geometria Non Commutativa}\\ \scriptsize se le Algebre C* commutative sono spazi, quelle non commutative sono "spazi generalizzati" -- programma di Connes};

\draw[mainArr] (algebraC) -- node[arrLbl, above]{caso commutativo} (gelfandnaimark);
\draw[mainArr] (gelfandnaimark) -- node[arrLbl, above]{+ abbandona la commutatività} (noncommutativa);

% =====================================================================
% CATEGORIA 28 — INVARIANTI, GALOIS DIFFERENZIALE, ALGEBRA COMPUTAZIONALE
% =====================================================================
\node[structNode, below=4.2cm of algebraC] (teoremainvarianti) {\textbf{Teorema di Hilbert sugli Invarianti}\\ \scriptsize per un gruppo che agisce (Cat.\ 16) su un anello di polinomi, l'anello degli invarianti è finitamente generato -- \textit{dimostrato mostrando che è Noetheriano, Cat.\ 22}};
\node[structNode, right=2.6cm of teoremainvarianti] (galoisdifferenziale) {\textbf{Teoria di Galois Differenziale}\\ \scriptsize un'equazione differenziale è risolubile "per quadrature" $\iff$ il suo gruppo di Galois differenziale è risolubile -- \textit{parallelo esatto di Abel--Ruffini (Cat.\ 22)}};
\node[structNode, right=2.6cm of galoisdifferenziale] (groebner) {\textbf{Basi di Groebner}\\ \scriptsize generatori speciali di un Ideale (Cat.\ 15) che rendono algoritmico decidere appartenenza e risolvere sistemi polinomiali -- \textit{esistono sempre perché l'anello di polinomi è Noetheriano, Cat.\ 22}};

% =====================================================================
% CATEGORIA 29 — ALGEBRA SIMMETRICA E TENSORI
% =====================================================================
\node[structNode, below=4.2cm of teoremainvarianti] (algebrasimmetrica) {\textbf{Algebra Simmetrica} $\mathrm{Sym}(V)$\\ \scriptsize $T(V)/I$, $I=\langle v\otimes w - w\otimes v\rangle$ -- la gemella simmetrica dell'Algebra di Grassmann (Cat.\ 5): stesso quoziente, segno opposto};
\node[structNode, right=2.6cm of algebrasimmetrica] (tensoremetrico) {\textbf{Tensore Metrico} $g_{\mu\nu}$\\ \scriptsize la Forma Bilineare (Cat.\ 7) o il Prodotto Interno (Cat.\ 4), scritti con indici e fatti variare da punto a punto su una varietà};
\node[structNode, right=2.6cm of tensoremetrico] (kronecker) {\textbf{Prodotto di Kronecker}\\ \scriptsize la versione a matrici del Prodotto Tensoriale (Cat.\ 18): $(A\otimes B)$ agisce su $V\otimes W$};
\node[structNode, right=2.6cm of kronecker] (clebschgordan) {\textbf{Coefficienti di Clebsch--Gordan}\\ \scriptsize decompongono il prodotto tensoriale di due Rappresentazioni (Cat.\ 19/20b) in una somma di rappresentazioni irriducibili};
\node[structNode, right=2.6cm of clebschgordan] (tuckersvd) {\textbf{Decomposizione CP / Tucker}\\ \scriptsize generalizza la SVD (Cat.\ 21b) ai tensori di ordine superiore a 2};

\draw[mainArr] (algebrasimmetrica) -- node[arrLbl, above]{indici, punto per punto} (tensoremetrico);

% =====================================================================
% CATEGORIA 30 — TEORIA DEI NUMERI
% =====================================================================
\node[structNode, below=4.2cm of algebrasimmetrica] (congruenze) {\textbf{Aritmetica Modulare}\\ \scriptsize congruenze $a\equiv b\pmod n$: aritmetica nell'Anello Quoziente $\mathbb{Z}/n\mathbb{Z}$ (Cat.\ 15) -- \textit{il Teorema Cinese del Resto (Cat.\ 17) la scompone quando $n$ non è primo}};
\node[structNode, right=2.6cm of congruenze] (funzarit) {\textbf{Funzioni Aritmetiche}\\ \scriptsize $\varphi$ di Eulero, funzione di Möbius $\mu$, funzione $\sigma$ dei divisori};
\node[structNode, right=2.6cm of funzarit] (fermateulero) {\textbf{Piccolo Teorema di Fermat / Eulero}\\ \scriptsize $a^{p-1}\equiv 1\pmod p$; generalizzato: $a^{\varphi(n)}\equiv 1\pmod n$ -- \textit{caso particolare del Teorema di Lagrange (Cat.\ 39) sul gruppo $(\mathbb{Z}/n\mathbb{Z})^{*}$}};
\node[structNode, right=2.6cm of fermateulero] (reciprocita) {\textbf{Reciprocità Quadratica}\\ \scriptsize lega la risolubilità di $x^2\equiv p\pmod q$ e $x^2\equiv q\pmod p$};
\node[structNode, right=2.6cm of reciprocita] (curveellittiche) {\textbf{Curve Ellittiche}\\ \scriptsize $y^2=x^3+ax+b$: i punti formano un Gruppo Abeliano (Cat.\ 1) -- crittografia a curve ellittiche};
\node[structNode, right=2.6cm of curveellittiche] (zetariemann) {\textbf{Funzione Zeta di Riemann} $\zeta(s)$\\ \scriptsize $\sum n^{-s}=$ prodotto di Eulero su tutti i primi};
\node[structNode, right=2.6cm of zetariemann] (distribprimi) {\textbf{Distribuzione dei Numeri Primi}\\ \scriptsize Teorema dei Numeri Primi: $\pi(x)\sim x/\ln x$};

\draw[mainArr] (congruenze) -- node[arrLbl, above]{invertibili mod $n$} (funzarit);
\draw[mainArr] (funzarit) -- node[arrLbl, above]{caso $n=p$ primo} (fermateulero);
\draw[mainArr] (zetariemann) -- node[arrLbl, above]{codifica} (distribprimi);

% =====================================================================
% CATEGORIA 31 — COMBINATORIA ALGEBRICA E TEORIA SPETTRALE DEI GRAFI
% =====================================================================
\node[structNode, below=3.8cm of congruenze] (grafolaplaciano) {\textbf{Grafo e Matrice Laplaciana} $L=D-A$\\ \scriptsize matrice di adiacenza $A$ e matrice dei gradi $D$ di un grafo};
\node[structNode, right=2.6cm of grafolaplaciano] (spettrografo) {\textbf{Spettro di un Grafo}\\ \scriptsize Autovalori (Cat.\ 21b) della Laplaciana: codificano connettività e struttura};
\node[structNode, right=2.6cm of spettrografo] (mobiusposet) {\textbf{Funzione di Möbius Combinatoria}\\ \scriptsize generalizza la $\mu$ aritmetica (Cat.\ 30) a un Reticolo (Cat.\ 13) qualsiasi};
\node[structNode, right=2.6cm of mobiusposet] (funzgeneratrici) {\textbf{Funzioni Generatrici}\\ \scriptsize una successione codificata come coefficienti di una serie formale};
\node[structNode, right=2.6cm of funzgeneratrici] (polya) {\textbf{Enumerazione di Pólya}\\ \scriptsize conta oggetti a meno di simmetria usando un'Azione di Gruppo (Cat.\ 16)};

\draw[mainArr] (grafolaplaciano) -- node[arrLbl, above]{autovalori} (spettrografo);

% =====================================================================
% CATEGORIA 32 — FONDAMENTI E LOGICA
% =====================================================================
\node[structNode, below=3.8cm of grafolaplaciano] (zfc) {\textbf{Assiomi di ZFC}\\ \scriptsize il sistema assiomatico su cui è costruita quasi tutta la matematica di questo schema};
\node[structNode, right=2.6cm of zfc] (cardinali) {\textbf{Cardinalità e Numeri Ordinali}\\ \scriptsize misure della dimensione e dell'ordine degli insiemi infiniti -- \textit{per conteggio: gli Algebrici (Cat.\ 9) sono numerabili, quindi "quasi tutti" i reali sono Trascendenti}};
\node[structNode, right=2.6cm of cardinali] (teoriamodelli) {\textbf{Teoria dei Modelli}\\ \scriptsize studia le strutture algebriche (Cat.\ 1--29) come interpretazioni di teorie del prim'ordine};

% =====================================================================
% CATEGORIA 39 — TEOREMA DI LAGRANGE, AUTOMI E TEOREMA DI KLEENE
% (posizionata a destra della Cat. 32, per usare lo spazio libero)
% =====================================================================
\node[structNode, right=8cm of teoriamodelli] (lagrangeteor) {\textbf{Teorema di Lagrange}\\ \scriptsize per $H\le G$ finito: $|G|=[G:H]\cdot|H|$ -- caso particolare del Teorema Orbita-Stabilizzatore (Cat.\ 16) sull'azione di $G$ su $G/H$};
\node[structNode, right=2.6cm of lagrangeteor] (automimonoidi) {\textbf{Automa e Monoide di Transizione}\\ \scriptsize ad ogni automa a stati finiti si associa un Monoide (Cat.\ 1): il linguaggio riconosciuto dipende solo da questo};
\node[structNode, right=2.6cm of automimonoidi] (kleeneteor) {\textbf{Teorema di Kleene}\\ \scriptsize i linguaggi regolari sono esattamente quelli riconoscibili da un Monoide finito -- l'algebra incontra l'informatica teorica};

\draw[mainArr] (automimonoidi) -- node[arrLbl, above]{linguaggi regolari} (kleeneteor);

