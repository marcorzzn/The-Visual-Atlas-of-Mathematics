\node[structNode, below=3.6cm of reali, xshift=3cm] (razionali) {\textbf{Numeri Razionali} $\mathbb{Q}$\\ \scriptsize campo delle frazioni di $\mathbb{Z}$};
\node[structNode, right=2.6cm of razionali] (algebrici) {\textbf{Numeri Algebrici}\\ \scriptsize radici di un polinomio non nullo a coefficienti in $\mathbb{Q}$};
\node[structNode, right=2.6cm of algebrici] (trascendenti) {\textbf{Numeri Trascendenti}\\ \scriptsize non algebrici: es. $\pi$, $e$};
\node[structNode, below=2.2cm of algebrici] (chiusuraalg) {\textbf{Chiusura Algebrica} $\overline{\mathbb{Q}}$\\ \scriptsize campo algebricamente chiuso minimale contenente $\mathbb{Q}$};

