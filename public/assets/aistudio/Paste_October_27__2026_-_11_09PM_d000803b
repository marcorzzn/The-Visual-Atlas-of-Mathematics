% CATEGORIA 22 — STRUTTURA DI GRUPPI E ANELLI: TEOREMI CLASSICI
% =====================================================================
\node[structNode, below=4.5cm of svd] (risolubile) {\textbf{Gruppo Risolubile}\\ \scriptsize catena di sottogruppi normali $\{e\}=G_0\trianglelefteq G_1\trianglelefteq\cdots\trianglelefteq G_n=G$ con quozienti abeliani};
\node[structNode, right=2.6cm of risolubile] (abelruffini) {\textbf{Teorema di Abel--Ruffini}\\ \scriptsize un'equazione polinomiale è risolubile per radicali $\iff$ il suo Gruppo di Galois (Cat.\ 17) è risolubile -- \textit{per grado $\ge 5$ il gruppo generico $S_n$ non lo è: nessuna formula risolutiva}};
\node[structNode, right=2.6cm of abelruffini] (jordanholder) {\textbf{Teorema di Jordan--Hölder}\\ \scriptsize ogni gruppo finito ha una serie di composizione; i fattori sono unici a meno di ordine e isomorfismo -- \textit{i "numeri primi" della teoria dei gruppi}};
\node[structNode, right=2.6cm of jordanholder] (gruppisemplici) {\textbf{Gruppo Semplice}\\ \scriptsize nessun sottogruppo normale proprio non banale -- i mattoni indivisibili di Jordan--Hölder};
\node[structNode, right=4cm of gruppisemplici] (noetheriano) {\textbf{Anello Noetheriano}\\ \scriptsize ogni ideale è finitamente generato (catena ascendente di ideali stazionaria) -- \textit{condizione che rende trattabile la Geometria Algebrica, Cat.\ 18}};
\node[structNode, right=2.6cm of noetheriano] (eulero) {\textbf{Caratteristica di Eulero} $\chi(X)$\\ \scriptsize $\chi(X)=\sum_i (-1)^i \mathrm{rank}\,H_i(X)$ -- l'Omologia (Cat.\ 20a) ridotta a un solo numero};
\node[structNode, below=4.2cm of jordanholder] (strutturamoduli) {\textbf{Teorema di Struttura dei Moduli f.g.\ su un PID}\\ \scriptsize ogni modulo finitamente generato su un PID si decompone in somma diretta di moduli ciclici $R/(d_1)\oplus\cdots\oplus R/(d_n)$};
\node[structNode, right=2.6cm of strutturamoduli] (gruppiabelianifiniti) {\textbf{Teorema Fondamentale dei Gruppi Abeliani Finiti}\\ \scriptsize caso $R=\mathbb{Z}$: ogni gruppo abeliano finito è $\mathbb{Z}/d_1\mathbb{Z}\oplus\cdots\oplus\mathbb{Z}/d_n\mathbb{Z}$ -- imparentato col Teorema Cinese del Resto (Cat.\ 17)};
\node[structNode, right=2.6cm of gruppiabelianifiniti] (jordanunificato) {\textbf{...e la Forma di Jordan}\\ \scriptsize caso $R=\mathbb{K}[x]$: lo stesso identico teorema, applicato a $V$ come $\mathbb{K}[x]$-modulo via $T$, \emph{è} la Forma Canonica di Jordan (Cat.\ 21b) -- due teoremi che in realtà erano sempre stati uno};

\draw[mainArr] (strutturamoduli) -- node[arrLbl, above]{caso $R=\mathbb{Z}$} (gruppiabelianifiniti);
