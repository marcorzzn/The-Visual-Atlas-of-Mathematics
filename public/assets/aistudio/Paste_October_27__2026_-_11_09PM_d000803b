% CATEGORIA 25 — ALGEBRA COMMUTATIVA E OMOLOGICA AVANZATA
% =====================================================================
\node[structNode, below=4.5cm of cristallografici] (dedekind) {\textbf{Dominio di Dedekind}\\ \scriptsize dominio d'integrità Noetheriano (Cat.\ 22) in cui ogni ideale si fattorizza in modo unico come prodotto di ideali primi -- generalizza il PID (Cat.\ 2) senza esserlo};
\node[structNode, right=2.6cm of dedekind] (localizzazione) {\textbf{Localizzazione di un Anello}\\ \scriptsize si rendono invertibili gli elementi di un sottoinsieme moltiplicativo -- costruzione gemella del passaggio da $\mathbb{Z}$ a $\mathbb{Q}$};
\node[structNode, right=2.6cm of localizzazione] (complessocatene) {\textbf{Complesso di Catene}\\ \scriptsize successione di gruppi/moduli con $\partial^2=0$: l'impalcatura algebrica dietro l'Omologia (Cat.\ 20a)};
\node[structNode, right=2.6cm of complessocatene] (exttor) {\textbf{Ext e Tor}\\ \scriptsize funtori derivati di $\mathrm{Hom}$ e $\otimes$: misurano quanto un modulo è lontano dall'essere libero o proiettivo};
\node[structNode, right=2.6cm of exttor] (categoriaabeliana) {\textbf{Categoria Abeliana}\\ \scriptsize una Categoria (Cat.\ 11) dove nucleo, immagine e successioni esatte hanno senso -- l'ambiente naturale di Ext e Tor};

\draw[mainArr] (dedekind) -- node[arrLbl, above]{+ inverti un sottoinsieme} (localizzazione);
