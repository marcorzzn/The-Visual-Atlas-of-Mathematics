% =====================================================================
% CATEGORIA 18 — GEOMETRIA ALGEBRICA, DIFFERENZIALE E ALGEBRA MULTILINEARE ESTESA
% =====================================================================
\node[structNode, below=4.5cm of spazioquoz] (varieta) {\textbf{Varietà Algebrica}\\ \scriptsize luogo degli zeri di polinomi: $V(S)=\{x: f(x)=0\ \forall f\in S\}$};
\node[structNode, right=2.6cm of varieta] (nullstellensatz) {\textbf{Nullstellensatz di Hilbert}\\ \scriptsize varietà $\leftrightarrow$ ideali radicali, su un campo algebricamente chiuso};
\node[structNode, right=4cm of nullstellensatz] (varietadiff) {\textbf{Varietà Differenziabile}\\ \scriptsize spazio topologico localmente omeomorfo a $\mathbb{R}^n$, con carte lisce (un Gruppo di Lie ne è un caso particolare)};
\node[structNode, right=2.6cm of varietadiff] (fibratotang) {\textbf{Fibrato Tangente} $TM$\\ \scriptsize unione degli spazi tangenti in ogni punto della varietà};
\node[structNode, right=2.6cm of fibratotang] (campovett) {\textbf{Campo Vettoriale}\\ \scriptsize sezione del fibrato tangente: un vettore tangente per ogni punto -- \textit{es.: campo di velocità di un fluido, campo gravitazionale}};
\node[structNode, right=2.6cm of campovett] (formediff) {\textbf{Forma Differenziale} $\omega\in\Omega^k(M)$\\ \scriptsize campo di $k$-covettori su una varietà: il duale del Multivettore (Cat.\ 10), sezione di $\Lambda^k T^{*}M$};
\node[structNode, right=2.6cm of formediff] (derivataesterna) {\textbf{Derivata Esterna} $d:\Omega^k\to\Omega^{k+1}$\\ \scriptsize generalizza gradiente ($k{=}0{\to}1$), rotore ($k{=}1{\to}2$ in $\mathbb{R}^3$) e divergenza ($k{=}2{\to}3$); sempre $d^2=0$};
\node[structNode, right=4cm of derivataesterna] (prodtensspazi) {\textbf{Prodotto Tensoriale} $V\otimes W$\\ \scriptsize il più generale spazio bilineare costruito da $V$ e $W$};
\node[structNode, right=2.6cm of prodtensspazi] (contrazione) {\textbf{Contrazione / Traccia}\\ \scriptsize accoppia un indice controvariante con uno covariante, riduce il rango del tensore};

\draw[mainArr] (varieta) -- node[arrLbl, above]{+ campo algebr.\ chiuso} (nullstellensatz);
