% =====================================================================
% CATEGORIA 17 — TEORIA DI GALOIS E PRODOTTI DI GRUPPI
% =====================================================================
\node[structNode, right=4cm of teoremaorbstab] (estcampo) {\textbf{Estensione di Campo} $L/K$\\ \scriptsize $K\subseteq L$: $L$ è spazio vett.\ su $K$, grado $[L:K]=\dim_K L$};
\node[structNode, right=2.6cm of estcampo] (estalgebrica) {\textbf{Estensione Algebrica}\\ \scriptsize ogni elemento di $L$ è radice di un polinomio a coefficienti in $K$};
\node[structNode, right=2.6cm of estalgebrica] (gruppogalois) {\textbf{Gruppo di Galois} $\mathrm{Gal}(L/K)$\\ \scriptsize automorfismi di $L$ che fissano $K$ punto per punto};
\node[structNode, below=2.2cm of estalgebrica] (corrispgalois) {\textbf{Corrispondenza di Galois}\\ \scriptsize sottogruppi di $\mathrm{Gal}(L/K)$ $\leftrightarrow$ campi intermedi $K\subseteq M\subseteq L$, un Reticolo (Cat.\ 13) rovesciato -- \textit{stessa struttura del Nullstellensatz (Cat.\ 18) e della Dualità di Stone (Cat.\ 19)}};
\node[structNode, below=2.2cm of estcampo] (crt) {\textbf{Teorema Cinese del Resto}\\ \scriptsize $\mathbb{Z}/n\mathbb{Z}\cong \mathbb{Z}/n_1\mathbb{Z}\times\cdots\times\mathbb{Z}/n_k\mathbb{Z}$ se gli $n_i$ coprimi};
\node[structNode, below=2.2cm of gruppogalois] (prodsemidiretto) {\textbf{Prodotto Diretto e Semidiretto}\\ \scriptsize $G\times H$; $G\ltimes H$ quando $G$ agisce su $H$ per automorfismi};

