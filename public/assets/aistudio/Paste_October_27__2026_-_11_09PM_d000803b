% =====================================================================
% CATEGORIA 5 — ALGEBRE
% =====================================================================
\node[structNode, below=4.2cm of spaziovett] (algcampo) {\textbf{Algebra su Campo}\\ \scriptsize spazio vettoriale + prodotto bilineare interno $a\cdot b$};
\node[structNode, below=3.0cm of algcampo, xshift=-4.6cm] (algassoc) {\textbf{Algebra Associativa}\\ \scriptsize $(a\cdot b)\cdot c = a\cdot(b\cdot c)$};
\node[structNode, below=2.4cm of algassoc] (algcomm) {\textbf{Algebra Commutativa}\\ \scriptsize $a\cdot b = b\cdot a$};
\node[structNode, below=3.0cm of algcampo, xshift=4.6cm] (alglie) {\textbf{Algebra di Lie} $\mathfrak{g}$\\ \scriptsize prodotto $[X,Y]$ antisimmetrico, identità di Jacobi};
\node[structNode, below=5.6cm of algcampo] (algtens) {\textbf{Algebra Tensoriale} $T(V)$\\ \scriptsize prodotto libero $\otimes$, nessun vincolo};
\node[structNode, below=2.6cm of algtens, xshift=-3.2cm] (grassmann) {\textbf{Algebra di Grassmann} $\Lambda(V)$\\ \scriptsize $T(V)/I$, $\ I=\langle v\otimes v\rangle$: $v\wedge w = -w\wedge v$};
\node[structNode, below=2.6cm of algtens, xshift=3.2cm] (clifford) {\textbf{Algebra di Clifford} $C\ell_q(V)$\\ \scriptsize $T(V)/I$, $\ I=\langle v\otimes v - Q(v)\rangle$ -- \textit{spinori: Relatività e Meccanica Quantistica}};

\draw[mainArr] (algcampo) -- node[arrLbl, above, sloped]{+ associatività} (algassoc);
\draw[mainArr] (algassoc) -- node[arrLbl, right]{+ commutatività} (algcomm);
\draw[mainArr] (algcampo) -- node[arrLbl, above, sloped]{antisimmetria + Jacobi} (alglie);
\node[structNode, right=4cm of alglie] (universale) {\textbf{Algebra Inviluppante Universale} $U(\mathfrak{g})$\\ \scriptsize $T(\mathfrak{g})/I$, $\ I=\langle X\otimes Y-Y\otimes X-[X,Y]\rangle$: "doma" l'algebra di Lie rendendola associativa (Teorema di Poincaré--Birkhoff--Witt)};
\draw[mainArr] (alglie) -- node[arrLbl, above]{quoziente: incapsula $[X,Y]$} (universale);
\draw[crossArr] (algtens) to[bend left=10] node[arrLbl, below, pos=0.4]{stessa costruzione: quoziente di $T(\cdot)$} (universale.south);
\draw[mainArr] (algtens) -- node[arrLbl, left]{quoziente: $v\otimes v = 0$} (grassmann);
\draw[mainArr] (algtens) -- node[arrLbl, right]{quoziente: $v^2 = Q(v)$} (clifford);
\draw[crossArr] (algassoc) to[bend left=15] node[arrLbl, left]{è un'istanza di} (algtens);

